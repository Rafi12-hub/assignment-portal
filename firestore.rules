rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles collection
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Tasks collection: Students can only read, create, update, and delete their own tasks
    match /tasks/{taskId} {
      // Allow read/list if authenticated and task belongs to the user
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // Allow create if authenticated and the new task's userId matches the auth uid
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      
      // Allow update/delete if authenticated and existing task's userId matches the auth uid
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
